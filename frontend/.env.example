# ==============================================================================
# 17Money frontend — ortam değişkenleri ÖRNEĞİ
#
# Kullanım: bu dosyayı frontend/.env olarak kopyalayın (CRA otomatik okur).
# CRA yalnızca REACT_APP_ ile başlayan değişkenleri tarayıcıya verir.
# Tümü OPSİYONELDİR; yazılmazsa koddaki varsayılanlar (yerel geliştirme) geçerli
# olur. Değerler değişirse geliştirme sunucusunu Yeniden başlatın.
#
# ÖNEMLİ: .env dosyasına SIR (API anahtarı) YAZMAYIN — tarayıcıya açıktır.
# Anahtarların tamamı backend/config/.env içinde tutulur.
# ==============================================================================

# Backend adresi (üretimde ör. https://api.ornek.com)
# REACT_APP_API_BASE=http://localhost:8000

# WebSocket adresi (boşsa REACT_APP_API_BASE'den türetilir: ws://…/ws/market)
# REACT_APP_WS_URL=ws://localhost:8000/ws/market

# Sembol ve varsayılan zaman dilimi
# REACT_APP_SYMBOL=BTCUSDT
# REACT_APP_DEFAULT_INTERVAL=1h
# REACT_APP_INTERVALS=15m,1h,4h,1d

# Açılışta seçili model (backend'deki geçerli model kimliklerinden biri)
# REACT_APP_DEFAULT_MODEL=claude-fable-5
