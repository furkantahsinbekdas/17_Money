# ==============================================================================
# 17Money Algorithm — ortam değişkenleri ÖRNEĞİ
#
# Kullanım:
#   1) copy config\.env.example config\.env      (Windows)
#      cp config/.env.example config/.env        (macOS/Linux)
#   2) Aşağıdaki "ZORUNLU SIRLAR" bölümündeki yer tutucuları kendi
#      anahtarlarınızla değiştirin. Diğer bölümler TAMAMEN OPSİYONELDİR;
#      boş bırakılan her ayar backend/config.py'deki varsayılana döner.
#
# İlkeler:
#   - Hiçbir API anahtarı koda gömülü DEĞİLDİR; her şey bu dosyadan okunur.
#   - `your_...` ile başlayan ya da boş bırakılan anahtar "yapılandırılmamış"
#     sayılır: sistem çökmez, sadece o özellik (Claude/Binance/haber) devre
#     dışı kalır ve /api/ai/status bunu bildirir.
#   - config/.env SÜRÜM KONTROLÜNE GİRMEZ (.gitignore). Bu örnek dosya girer.
#   - Tüm ayarların tam listesi ve varsayılan değerleri: backend/config.py
# ==============================================================================

# ------------------------------------------------------------------------------
# 1) SIRLAR — yer tutucuları gerçek anahtarlarla değiştirin
# ------------------------------------------------------------------------------
# Binance Futures anahtarları (testnet anahtarı kullanın).
# Testnet: https://testnet.binancefuture.com
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=true

# Anthropic API anahtarı — BOŞ BIRAKILABİLİR: boşsa sistem bu makinede oturum
# açılmış Claude Code CLI üzerinden çalışır (abonelik; API key gerekmez).
# Doldurulursa Claude çağrıları doğrudan Anthropic API'ye gider.
CLAUDE_API_KEY=your_anthropic_api_key_here

# Haber kaynakları — opsiyonel (ikisi de boşsa haber katmanı sessizce devre
# dışı kalır; sinyal üretimi çalışmaya devam eder).
# NewsAPI: https://newsapi.org  |  CryptoPanic: https://cryptopanic.com/developers/api/
NEWS_API_KEY=your_newsapi_org_key_here
CRYPTOPANIC_KEY=your_cryptopanic_key_here

# ------------------------------------------------------------------------------
# 2) SUNUCU / CORS  (config.py bölüm 3 — varsayılanlar yorumda)
# ------------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# APP_HOST=0.0.0.0
# APP_PORT=8000
# APP_RELOAD=true
# LOG_LEVEL=info
# APP_TITLE=17Money Algorithm API
# APP_DESCRIPTION=BTC/USDT Futures AI Trading Partner
# APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 3) PİYASA / SEMBOL / ZAMAN DİLİMLERİ  (config.py bölüm 4)
# ------------------------------------------------------------------------------
# SYMBOL=BTCUSDT
# MTF_INTERVALS=1d,4h,1h,15m        # çoklu zaman dilimi analiz merdiveni
# FORECAST_INTERVALS=15m,1h,4h,1d   # tahmin motoru dilimleri
# TRADE_INTERVALS=15m,1h,4h,1d      # işlem/etiketleme için kabul edilen dilimler
# DEFAULT_INTERVAL=1h
# KLINE_LIMIT=250                   # sinyal/analiz mum penceresi
# BROADCAST_KLINE_LIMIT=200         # WebSocket yayını
# DAILY_KLINE_LIMIT=120             # intermarket baz penceresi
# INTERMARKET_KLINE_LIMIT=100
# SCIENCE_KLINE_LIMIT=500           # stokastik motor penceresi
# SCIENCE_KLINE_MIN=120             # istatistik için alt sınır
# ORDERBOOK_LIMIT=20                # emir defteri derinliği
# SHOCK_KLINE_LIMIT=5               # alarm fiyat şoku penceresi
# BARS_PER_DAY={"1m":1440,"5m":288,"15m":96,"1h":24,"4h":6,"1d":1}

# ------------------------------------------------------------------------------
# 4) ARKA PLAN DÖNGÜLERİ (saniye)  (config.py bölüm 5 — main.py lifespan)
# ------------------------------------------------------------------------------
# BROADCAST_INTERVAL_SEC=60          # piyasa yayını
# RESOLVE_INTERVAL_SEC=600           # açık sinyal etiketleme
# COLLECT_INTERVAL_SEC=3600          # AI'sız otomatik veri toplama
# COLLECT_STARTUP_DELAY_SEC=120
# CHALLENGE_CHECK_INTERVAL_SEC=3600  # şampiyon–meydan okuyan kontrolü
# CHALLENGE_STARTUP_DELAY_SEC=300
# ALERT_INTERVAL_SEC=900             # acil haber taraması
# ALERT_STARTUP_DELAY_SEC=45
# STARTUP_RECOVERY_DELAY_SEC=20      # açılışta toparlanma
# TRAINING_CHALLENGE_INTERVAL_SEC=60 # elle "EĞİTİME BAŞLA" tur aralığı
# TRAINING_STOP_JOIN_TIMEOUT_SEC=5   # durdurma join süresi

# ------------------------------------------------------------------------------
# 5) CLAUDE / LLM  (config.py bölüm 6)
# ------------------------------------------------------------------------------
# NOT: Model kimlikleri zamanla değişir. Hesabınızda geçerli olan kimliği yazın.
# CLAUDE_MODEL=claude-fable-5
# CLAUDE_CLI_MODEL=                 # boşsa CLAUDE_MODEL kullanılır
# CLAUDE_CLI_PATH=                  # claude CLI yolu (boşsa otomatik bulunur)
# CLAUDE_VOTE_MODEL=claude-sonnet-4-6
# Sohbette seçilebilir modeller: id=etiket,id=etiket
# CLAUDE_CHAT_MODELS=claude-fable-5=Fable 5 — en güçlü, en derin analiz,claude-opus-4-8=Opus 4.8 — güçlü, daha verimli,claude-sonnet-4-6=Sonnet 4.6 — hızlı ve dengeli,claude-haiku-4-5=Haiku 4.5 — en hızlı, basit sorular
# CLAUDE_MAX_TOKENS_SIGNAL=16000
# CLAUDE_MAX_TOKENS_FORECAST=16000
# CLAUDE_MAX_TOKENS_CHAT=4000
# CLAUDE_MAX_TOKENS_RESEARCH=16000
# CLAUDE_WEB_SEARCH_TOOL=web_search_20260209
# CLAUDE_WEB_SEARCH_MAX_USES_CHAT=4
# CLAUDE_WEB_SEARCH_MAX_USES_RESEARCH=8
# CLAUDE_WEB_SEARCH_MAX_TURNS_CHAT=4
# CLAUDE_WEB_SEARCH_MAX_TURNS_RESEARCH=5
# CHAT_HISTORY_TURNS=12             # prompt'a taşınan son mesaj sayısı
# SIGNAL_NEWS_LIMIT=8               # sinyal prompt'una giren haber sayısı
# RESEARCH_SOURCES_LIMIT=10         # raporda listelenen kaynak sayısı
# CLAUDE_CLI_TIMEOUT_SEC=300        # derin sinyal çağrısı
# CLAUDE_CLI_CHAT_TIMEOUT_SEC=180
# CLAUDE_CLI_VOTE_TIMEOUT_SEC=90
# CLAUDE_CLI_STATUS_TIMEOUT_SEC=30
# RESEARCH_DEFAULT_FOCUS=BTC fiyatını önümüzdeki 24-72 saatte etkileyebilecek gelişmeler

# ------------------------------------------------------------------------------
# 6) TRIPLE-BARRIER + REJİM BARIYERLERİ  (config.py bölüm 8 — etiketleme)
# ------------------------------------------------------------------------------
# DİKKAT: Bu değerler eğitilmiş meta-modelin SÖZLEŞMESİdir. Değiştirirseniz
# modeli yeniden eğitmeniz gerekir (POST /api/meta/train).
# TP_ATR_MULT=1.5
# SL_ATR_MULT=1.0
# HORIZON_BARS=24
# REGIME_ADX_STRONG=30.0
# REGIME_ADX_MILD=22.0
# REGIME_TP_STRONG=2.5
# REGIME_SL_STRONG=1.2
# REGIME_TP_MILD=1.5
# REGIME_SL_MILD=1.0
# REGIME_TP_WEAK=1.0
# REGIME_SL_WEAK=1.0

# ------------------------------------------------------------------------------
# 7) PAPER TRADING + DEVRE KESİCİ  (config.py bölüm 9)
# ------------------------------------------------------------------------------
# PAPER_START_BALANCE=1000.0
# PAPER_RISK_PCT=0.02               # işlem başına sermayenin %2'si
# PAPER_COST_R=0.06                 # komisyon+funding+slipaj (R) — backtest de bunu kullanır
# PAPER_META_THRESHOLD=0.60         # model bu olasılığın üstünde onaylarsa işlem
# BREAKER_DD_LIMIT=0.25             # tepeden -%25 → yeni işlem DUR (insan onayı)
# COOLDOWN_LOSSES=5                 # ardışık kayıp → soğuma modu
# COOLDOWN_EXIT_WINS=2              # soğumadan çıkış
# COOLDOWN_RISK_SCALE=0.5           # soğumada risk çarpanı

# ------------------------------------------------------------------------------
# 8) META-MODEL + EĞİTİM  (config.py bölüm 10)
# ------------------------------------------------------------------------------
# META_MIN_SAMPLES=100              # altında eğitim reddedilir
# META_THRESHOLD=0.60               # işlem onay eşiği
# META_TRAIN_SPLIT=0.70             # ZAMAN SIRALI %70/%30 ayırma
# TRAIN_MIN_AUC_GAIN=0.01           # meydan okuyan şampiyonu en az bu kadar geçmeli
# TRAIN_MIN_ABS_AUC=0.50            # mutlak taban (yazı-turadan iyi olmalı)
# TRAIN_MIN_NEW_SAMPLES=30          # son terfiden beri gereken yeni örnek
# BACKFILL_VOTE_THRESHOLD=0.35      # |normalize oy| eşiği
# BACKFILL_MIN_ADX=18.0             # chop filtresi
# BACKFILL_MIN_GAP_BARS=6           # örtüşme azaltma
# BACKFILL_KLINE_LIMIT_4H=1000
# BACKFILL_KLINE_LIMIT_1D=500

# ------------------------------------------------------------------------------
# 9) SEANS / LİKİDİTE  (config.py bölüm 11 — UTC saat)
# ------------------------------------------------------------------------------
# LOW_LIQUIDITY_HOUR_START=0        # 00:00 dahil
# LOW_LIQUIDITY_HOUR_END=6          # 06:00 hariç → 00-05 UTC düşük likidite
# SESSION_ASIA_START=0
# SESSION_ASIA_END=8
# SESSION_EUROPE_START=8
# SESSION_EUROPE_END=13
# SESSION_US_START=13
# SESSION_US_END=21

# ------------------------------------------------------------------------------
# 10) ACİL HABER ALARMI  (config.py bölüm 12)
# ------------------------------------------------------------------------------
# CRISIS_KEYWORDS=war,savaş,invasion,...   # tam liste ve varsayılan: config.py
# HIGH_SEVERITY_KEYWORDS=war,savaş,hack,nuclear,collapse,çöküş,bankrupt,iflas,black swan,depeg
# SHOCK_LOOKBACK_BARS=3
# SHOCK_THRESHOLD_PCT=4.0
# SHOCK_STRONG_PCT=6.0
# ALERT_MEDIUM_MIN_KEYWORDS=2
# ALERT_HIGH_MIN_KEYWORDS=3
# ALERT_TITLE_LIMIT=5
# ALERT_SUMMARY_KEYWORD_LIMIT=3
# ALERT_KLINE_INTERVAL=15m

# ------------------------------------------------------------------------------
# 11) DIŞ SERVİSLER  (config.py bölüm 13)
# ------------------------------------------------------------------------------
# FEAR_GREED_API=https://api.alternative.me/fng/
# CRYPTOPANIC_API=https://cryptopanic.com/api/v1/posts/
# NEWSAPI_URL=https://newsapi.org/v2/everything
# YAHOO_CHART_URL=https://query1.finance.yahoo.com/v8/finance/chart
# BINANCE_VISION_URL=https://data.binance.vision/data/spot/monthly/klines/{sym}/{iv}/{sym}-{iv}-{ym}.zip
# BINANCE_VISION_FUNDING_URL=https://data.binance.vision/data/futures/um/monthly/fundingRate/{sym}/{sym}-fundingRate-{ym}.zip
# BINANCE_MAX_KLINES_PER_CALL=1500   # Binance tek çağrıda en fazla bu kadar mum verir
# HTTP_TIMEOUT_SEC=10.0
# YAHOO_TIMEOUT_SEC=15.0
# HISTORY_TIMEOUT_SEC=30.0
# HTTP_USER_AGENT=Mozilla/5.0
# NEWS_QUERY=bitcoin+crypto
# NEWS_LANGUAGE=en
# NEWS_ITEM_LIMIT=10
# NEWSAPI_PAGE_SIZE=5
# CORRELATION_RANGE=3mo
# CORRELATION_MIN_POINTS=20
# HISTORY_START_YEAR=2017
# HISTORY_START_MONTH=8
# FUNDING_START_YEAR=2019
# FUNDING_START_MONTH=9
# SIGNALS_RECENT_MAX=500             # GET /api/meta/signals tavanı

# ------------------------------------------------------------------------------
# 12) GÖSTERGE PARAMETRELERİ  (config.py bölüm 14)
# ------------------------------------------------------------------------------
# DİKKAT: feature_service.py bu pencerelerin birebir aynısını kullanır; değişirse
# meta-model geçersiz olur (yeniden eğitim şart).
# EMA_FAST=20
# EMA_MID=50
# EMA_SLOW=200
# RSI_PERIOD=14
# MACD_FAST=12
# MACD_SLOW=26
# MACD_SIGNAL=9
# ATR_PERIOD=14
# ADX_PERIOD=14
# BB_PERIOD=20
# BB_DEV=2.0
# STOCH_RSI_PERIOD=14
# STOCH_RSI_SMOOTH1=3
# STOCH_RSI_SMOOTH2=3
# VWAP_PERIOD=50
# VOLUME_AVG_PERIOD=20
# DIVERGENCE_LOOKBACK=60
# DIVERGENCE_SWING=3
# PREMIUM_DISCOUNT_LOOKBACK=100
# SR_LOOKBACK=150
# SR_SWING=5
# SR_CLUSTER_PCT=0.005
# OB_LOOKBACK=50
# FVG_LOOKBACK=30
# LIQUIDITY_LOOKBACK=50
# LIQUIDITY_SWING_PERIOD=5
# STRUCTURE_LOOKBACK=50
# NEUTRAL_INDEX=50.0

# ------------------------------------------------------------------------------
# 13) TAHMİN AĞIRLIKLARI + STOKASTİK  (config.py bölüm 15–16)
# ------------------------------------------------------------------------------
# FORECAST_WEIGHTS={"ema_dizilimi":2.0,"macd":1.5,"adx_yon":1.5,"yapi":1.5,"divergence":1.5,"rsi":1.0,"obv":1.0,"bollinger":0.5,"stoch_rsi":0.5,"vwap":0.5,"premium_discount":0.5}
# FORECAST_HORIZON_BLEND={"kisa":{"15m":0.4,"1h":0.6},"orta":{"1h":0.4,"4h":0.6},"uzun":{"4h":0.3,"1d":0.7}}
# FORECAST_OVERALL_BLEND={"kisa":0.20,"orta":0.35,"uzun":0.45}
# STOCHASTIC_DAYS_PER_YEAR=365
# FORECAST_HORIZON_HOURS=24

# ------------------------------------------------------------------------------
# 14) TANI (opsiyonel)  (config.py bölüm 17)
# ------------------------------------------------------------------------------
# CONFIG_DIAGNOSTICS=true   # açılışta eksik/yer tutucu anahtarları tek satır basar

